{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tapeheads attention and playback trace",
  "type": "object",
  "required": [
    "format",
    "encoder",
    "source",
    "model",
    "frames",
    "selection",
    "heads",
    "audio",
    "rendering"
  ],
  "properties": {
    "format": {
      "enum": [
        "tapeheads/1",
        "tapeheads/2"
      ]
    },
    "encoder": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "samples",
        "sample_rate_hz",
        "duration_seconds",
        "context_mode"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 1
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "context_mode": {
          "enum": [
            "full",
            "excerpt"
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "repository",
        "revision",
        "adapter",
        "layer_index",
        "context",
        "token_layout"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "layer_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      }
    },
    "frames": {
      "type": "object",
      "required": [
        "edges_samples",
        "query_samples",
        "range_convention"
      ],
      "properties": {
        "edges_samples": {
          "$ref": "#/$defs/samples"
        },
        "query_samples": {
          "$ref": "#/$defs/samples"
        },
        "range_convention": {
          "const": "half-open"
        }
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "guard_samples",
        "entry_alpha",
        "score",
        "version"
      ],
      "properties": {
        "guard_samples": {
          "type": "integer",
          "minimum": 0
        },
        "entry_alpha": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "heads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "selections",
          "playback"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "selections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "query_index",
                "query_sample",
                "output_end",
                "selected",
                "candidates"
              ],
              "properties": {
                "selected": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/block"
                    }
                  ]
                },
                "candidates": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/block"
                  }
                }
              }
            }
          },
          "playback": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/playback"
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "stems",
        "mix",
        "head_gain",
        "boundary_treatment"
      ]
    },
    "rendering": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps"
      ]
    }
  },
  "$defs": {
    "samples": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "block": {
      "type": "object",
      "required": [
        "key_start",
        "key_end",
        "source_start",
        "source_end",
        "volume",
        "mass",
        "peak"
      ],
      "properties": {
        "volume": {
          "type": "number",
          "minimum": 0
        },
        "mass": {
          "type": "number",
          "minimum": 0
        },
        "peak": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "playback": {
      "type": "object",
      "required": [
        "output_start",
        "output_end",
        "source_start",
        "source_end",
        "fade_in_samples",
        "fade_out_samples"
      ],
      "properties": {
        "output_start": {
          "type": "integer",
          "minimum": 0
        },
        "output_end": {
          "type": "integer",
          "minimum": 1
        },
        "source_start": {
          "type": "integer",
          "minimum": 0
        },
        "source_end": {
          "type": "integer",
          "minimum": 1
        },
        "fade_in_samples": {
          "type": "integer",
          "minimum": 0
        },
        "fade_out_samples": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "format": {
            "const": "tapeheads/2"
          }
        }
      },
      "then": {
        "required": [
          "near_monitor"
        ],
        "properties": {
          "selection": {
            "required": [
              "max_layer_blocks",
              "near_gain"
            ],
            "properties": {
              "max_layer_blocks": {
                "type": "integer",
                "minimum": 1
              },
              "near_gain": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              }
            }
          },
          "heads": {
            "items": {
              "required": [
                "voices"
              ],
              "properties": {
                "selections": {
                  "items": {
                    "required": [
                      "selected_blocks",
                      "near_attention"
                    ],
                    "properties": {
                      "selected_blocks": {
                        "type": "array",
                        "items": {
                          "allOf": [
                            {
                              "$ref": "#/$defs/block"
                            },
                            {
                              "required": [
                                "voice_id",
                                "playback_start",
                                "playback_end",
                                "mean_attention",
                                "threshold"
                              ]
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
